STUDYROOM_DB_URL=jdbc:mysql://127.0.0.1:3306/study_room?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
STUDYROOM_DB_USERNAME=studyroom
STUDYROOM_DB_PASSWORD=replace-with-a-long-random-password
STUDYROOM_DB_POOL_MAXIMUM=10
STUDYROOM_DB_POOL_MINIMUM_IDLE=2
STUDYROOM_DB_CONNECTION_TIMEOUT_MS=3000
STUDYROOM_DB_VALIDATION_TIMEOUT_MS=2000
STUDYROOM_INVITATION_PEPPER=replace-with-at-least-32-random-bytes
STUDYROOM_BCRYPT_STRENGTH=11
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8180
STUDYROOM_UPLOAD_DIR=/var/lib/studyroom-v2/uploads
STUDYROOM_RELEASE_ID=replace-with-release-id
STUDYROOM_RELEASE_GIT_SHA=replace-with-full-git-sha
STUDYROOM_RELEASE_BUILT_AT=replace-with-iso-8601-timestamp
STUDYROOM_READINESS_INTERVAL_MS=30000
STUDYROOM_READINESS_TIMEOUT_MS=2000
STUDYROOM_READINESS_STALE_AFTER_MS=90000
STUDYROOM_READINESS_MINIMUM_FREE_SPACE=8589934592
STUDYROOM_REDIS_HOST=127.0.0.1
STUDYROOM_REDIS_PORT=6379
STUDYROOM_REDIS_DATABASE=0
STUDYROOM_REDIS_PASSWORD=
STUDYROOM_SESSION_STORE=redis
STUDYROOM_PRODUCTION_MODE=true
STUDYROOM_COOKIE_SECURE=true
STUDYROOM_DESKTOP_ORIGIN=https://desktop.moyustation.xyz
STUDYROOM_CORS_ALLOW_ALL=false
STUDYROOM_CORS_ALLOWED_ORIGIN_PATTERNS=https://moyustation.xyz,https://www.moyustation.xyz,https://desktop.moyustation.xyz
STUDYROOM_CLIENT_UPDATES_ENABLED=false
STUDYROOM_CLIENT_UPDATES_BASE_URL=https://moyustation.xyz/private-updates
STUDYROOM_CLIENT_UPDATES_STORAGE_ROOT=/srv/studyroom-updates/releases
STUDYROOM_CLIENT_UPDATES_GRANT_TTL=10m
STUDYROOM_CLIENT_UPDATES_IMPORT_SECRET=replace-with-a-separate-random-secret
