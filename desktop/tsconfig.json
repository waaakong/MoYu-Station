{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "electron"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test-electron/**/*.ts", "scripts/**/*.mjs"]
}
